<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Системная заставка до первого кадра SwiftUI: без своего цвета она белая,
	     и запуск начинался вспышкой белого перед фирменным градиентом.
	     Вложенные ключи `UILaunchScreen` через build settings не задаются —
	     только файлом (проверено: INFOPLIST_KEY_UILaunchScreen_UIColorName
	     Xcode игнорирует, в собранный Info.plist приходит пустой словарь). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>splashLaunch</string>
	</dict>
</dict>
</plist>
